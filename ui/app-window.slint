import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "GlyphAtlas";
    min-width: 600px;
    min-height: 400px;
    preferred-width: 900px;
    preferred-height: 600px;
    background: #0d0d12;

    VerticalBox {
        alignment: center;
        spacing: 16px;

        Text {
            text: "GlyphAtlas";
            font-size: 28px;
            font-weight: 700;
            color: #e8e8f0;
            horizontal-alignment: center;
        }

        Text {
            text: "Unicode to Codepoint Converter — Slint (C++20 / Windows ARM64)";
            font-size: 14px;
            color: #8888aa;
            horizontal-alignment: center;
        }

        HorizontalBox {
            alignment: center;
            Button {
                text: "Minimal Scaffold Ready";
                primary: true;
            }
        }
    }
}
